<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_nb_card"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/icon"
            style="@style/Widget.Clipme.Logo"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="0dp"
            android:importantForAccessibility="no"
            android:padding="12dp" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="sans-serif-black"
            android:textColor="@color/ink"
            android:textSize="18sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBest"
            style="@style/Widget.Clipme.Toggle"
            android:text="@string/quality_best" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMedium"
            style="@style/Widget.Clipme.Toggle"
            android:text="@string/quality_medium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLow"
            style="@style/Widget.Clipme.Toggle"
            android:text="@string/quality_low" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
</LinearLayout>