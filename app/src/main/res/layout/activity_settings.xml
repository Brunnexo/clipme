<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include layout="@layout/view_header" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/Widget.Clipme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_quality" />

            <LinearLayout
                android:id="@+id/qualityList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/quality_hint"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                style="@style/Widget.Clipme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/section_location" />

            <RadioGroup
                android:id="@+id/locGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_nb_card"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <RadioButton
                    android:id="@+id/rbGallery"
                    style="@style/Widget.Clipme.Radio"
                    android:text="@string/loc_gallery" />

                <TextView
                    style="@style/Widget.Clipme.RadioHint"
                    android:text="@string/loc_gallery_hint" />

                <RadioButton
                    android:id="@+id/rbFolder"
                    style="@style/Widget.Clipme.Radio"
                    android:text="@string/loc_folder" />

                <TextView
                    android:id="@+id/folderLabel"
                    style="@style/Widget.Clipme.RadioHint" />

                <TextView
                    android:id="@+id/btnPickFolder"
                    style="@style/Widget.Clipme.Button"
                    android:layout_height="40dp"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="18dp"
                    android:text="@string/loc_pick"
                    android:textSize="13sp" />

                <RadioButton
                    android:id="@+id/rbPrivate"
                    style="@style/Widget.Clipme.Radio"
                    android:layout_marginTop="8dp"
                    android:text="@string/loc_private" />

                <TextView
                    style="@style/Widget.Clipme.RadioHint"
                    android:text="@string/loc_private_hint" />
            </RadioGroup>

            <TextView
                style="@style/Widget.Clipme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/section_accounts" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_nb_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Widget.Clipme.Logo"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="0dp"
                        android:importantForAccessibility="no"
                        android:padding="12dp"
                        android:src="@drawable/ic_youtube" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:text="YouTube"
                            android:textColor="@color/ink"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/ytStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btnYouTube"
                        style="@style/Widget.Clipme.Button"
                        android:layout_height="40dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="18dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/youtube_hint"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Clipme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/section_youtube_format" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_nb_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/ytFormat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFmtAsk"
                        style="@style/Widget.Clipme.Toggle"
                        android:text="@string/fmt_ask" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFmtVideo"
                        style="@style/Widget.Clipme.Toggle"
                        android:text="@string/fmt_video" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFmtAudio"
                        style="@style/Widget.Clipme.Toggle"
                        android:text="@string/fmt_audio" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/fmt_hint"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                style="@style/Widget.Clipme.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/section_capture" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_nb_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-black"
                        android:text="@string/capture_title"
                        android:textColor="@color/ink"
                        android:textSize="17sp" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/swCapture"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/capture_hint"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnAppInfo"
                    style="@style/Widget.Clipme.Button"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="18dp"
                    android:text="@string/open_app_info"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/captureStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/ink"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>